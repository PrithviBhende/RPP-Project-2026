<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="chartpaper_arena">
    <!-- Gazebo ROS State Plugin (provides /set_entity_state and /get_entity_state) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Base Ground Plane with Realistic Chart Paper Surface Friction (mu = 0.85) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000.0</kp>
                <kd>10.0</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- White Chart Paper Surface (1.5m x 1.0m, thickness 2mm) -->
    <model name="white_chart_paper">
      <static>true</static>
      <pose>0.5 0.0 0.0005 0 0 0</pose>
      <link name="paper_link">
        <visual name="paper_visual">
          <geometry>
            <box>
              <size>1.5 1.0 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>0.95 0.95 0.95 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark Obstacle Box 1 -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>0.4 0.15 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark Obstacle Box 2 -->
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>0.7 -0.15 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>0.14 0.14 0.08</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>0.14 0.14 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark Obstacle Box 3 -->
    <model name="obstacle_box_3">
      <static>true</static>
      <pose>0.85 0.15 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark Obstacle Box 4 -->
    <model name="obstacle_box_4">
      <static>true</static>
      <pose>0.85 0.15 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dark Obstacle Box 5 -->
    <model name="obstacle_box_5">
      <static>true</static>
      <pose>0.50 -0.05 0.04 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>0.12 0.12 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green Start Location Marker Disk (Follows dynamically directly below robot) -->
    <model name="start_marker">
      <static>true</static>
      <pose>-0.15 -0.40 0.0012 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.001</length></cylinder></geometry>
          <surface>
            <collide_without_contact>true</collide_without_contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.0005</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.85 0.15 1.0</ambient>
            <diffuse>0.1 0.85 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Goal Location Marker Disk (Interactive / Draggable anywhere on chart) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>1.15 0.40 0.0012 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.001</length></cylinder></geometry>
          <surface>
            <collide_without_contact>true</collide_without_contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.0005</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1.0</ambient>
            <diffuse>0.9 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Overhead Arena Camera (Looking straight down at chart paper from z = 2.0m) -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.5 0.0 2.0 0 1.5707963 0</pose>
      <link name="camera_link">
        <sensor type="camera" name="top_down_camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/</namespace>
              <remapping>image_raw:=overhead_camera/image_raw</remapping>
              <remapping>camera_info:=overhead_camera/camera_info</remapping>
            </ros>
            <frame_name>overhead_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Sesame Quadruped Robot (Spawned at Bottom-Left Corner of Chart Paper) -->
    <include>
      <uri>model://sesame_description</uri>
      <name>sesame_robot</name>
      <pose>-0.15 -0.40 0.001 0 0 0.55</pose>
    </include>

    <!-- Physics Parameters -->
    <physics type="ode">
      <real_time_update_rate>500.0</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Default Overhead Camera View -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.6 0.0 1.8 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
